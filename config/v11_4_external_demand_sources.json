  "secondary_domains": [
    "business-standard.com",
    "moneycontrol.com",
    "economictimes.indiatimes.com",
    "financialexpress.com",
    "livemint.com"
  ],
  "demand_terms": [
    "procurement",
    "tender",
    "award",
    "order",
    "capex",
    "investment",
    "scheme",
    "PLI",
    "production linked incentive",
    "approved",
    "sanctioned",
    "project",
    "capacity",
    "manufacturing",
    "commissioning",
    "rollout",
    "deployment"
  ],
  "event_weights": {
    "procurement_or_award": 1,
    "capex_or_project": 0.85,
    "policy_or_pli": 0.7,
    "deployment_or_commissioning": 0.8,
    "general_demand": 0.45
  },
  "required_discovery_sources": {
    "gdelt": true,
    "google_news": true
  },
  "source_policy": {
    "gdelt_access_preference": [
      "raw_gal_gkg_mentions",
      "bigquery_for_history",
      "doc_api_only_if_available"
    ],
    "google_news_access": "rss_search_discovery",
    "promotion_rule": "Discovery-source headlines never create high-confidence eligibility by themselves. High-confidence qualification requires auditable company/government/tender/rating/regulator evidence or resolved underlying-source corroboration.",
    "aggregator_rule": "GDELT and Google News are discovery/coverage layers. Neither aggregator title alone can be treated as primary evidence.",
    "degraded_run_rule": "If GDELT or Google News health fails, the source stage fails rather than silently substituting one for the other.",
    "duplicate_rule": "Duplicate stories across aggregators are collapsed; cross-source agreement is corroboration, not multiple independent catalysts."
  },
  "gdelt": {
    "live_article_feed": "https://data.gdeltproject.org/gdeltv3/gal/feed.rss",
    "role": "mandatory realtime/global discovery stream",
    "doc_api_role": "disabled for production gating because anonymous DOC API throttling is not reliable",
    "historical_role": "raw GAL/GKG archive or BigQuery for point-in-time backtests"
  },
  "google_news": {
    "rss_search": "https://news.google.com/rss/search",
    "lookback_days": 120,
    "role": "mandatory broad recent-news discovery",
    "max_results_per_theme": 60
  },
  "official_direct": {
    "pib_rss": [
      "https://pib.gov.in/RssMain.aspx?ModId=6&Lang=1&Regid=1",
      "https://pib.gov.in/RssMain.aspx?ModId=6&Lang=1&Regid=3",
